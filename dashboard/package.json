{
  "name": "eggmail-dashboard",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "EggMail web dashboard (Preact + Vite SPA)",
  "license": "(MIT OR Apache-2.0)",
  "engines": {
    "node": ">=22.12.0"
  },
  "scripts": {
    "dev": "vite",
    "dev:mock": "node mock/dev.mjs",
    "start:mock": "npm run build && node mock/server.mjs",
    "build": "vite build",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc --noEmit",
    "lint": "tsc --noEmit && node scripts/lint.mjs",
    "check-csp": "node scripts/check-csp.mjs",
    "size": "node scripts/size.mjs",
    "e2e": "npm run build && playwright test"
  },
  "dependencies": {
    "preact": "10.29.8",
    "preact-iso": "2.12.2"
  },
  "devDependencies": {
    "@playwright/test": "1.63.0",
    "@preact/preset-vite": "2.10.6",
    "@testing-library/preact": "3.2.4",
    "jsdom": "30.1.1",
    "typescript": "6.0.3",
    "vite": "8.3.3",
    "vitest": "5.0.3"
  }
}
