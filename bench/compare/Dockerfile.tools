# The load generator and the sink of the baseline comparison (src/Mta.Tools). Build context: the repository root.
FROM mcr.microsoft.com/dotnet/sdk:10.0 AS build
WORKDIR /src
COPY global.json Directory.Build.props Directory.Packages.props ./
COPY src/ src/
RUN dotnet publish src/Mta.Tools/Mta.Tools.csproj -c Release -o /out

FROM mcr.microsoft.com/dotnet/runtime:10.0
WORKDIR /app
COPY --from=build /out/ ./
ENTRYPOINT ["dotnet", "/app/mta-tools.dll"]
