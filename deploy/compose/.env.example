# Copy to .env next to the compose files and edit. Compose reads it automatically.

# Name announced in SMTP greetings and Received headers; must match the PTR record of the sending IP.
EGGMAIL_HOSTNAME=mail.example.com

# The image. Until the first stable release only nightly tags exist (ghcr.io/eggspot/eggmail:nightly). Pin a minor line
# (ghcr.io/eggspot/eggmail:1.4) or a digest in production, never :latest or :nightly.
EGGMAIL_IMAGE=ghcr.io/eggspot/eggmail:nightly

# Name of the first dashboard administrator (the password is the content of secrets/admin_password.txt).
EGGMAIL_ADMIN_USER=admin

# compose.postgres.yaml only: the password of the eggmail database role (letters and digits).
EGGMAIL_DB_PASSWORD=change-me-to-a-long-random-string
